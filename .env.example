# Knowledge Intelligence Platform v1.1.0 — Environment Variables Template
# Copy this file to `.env` for local development. Never commit `.env`.
# All settings have sensible defaults; credentials are only needed for live cloud providers.

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=Knowledge Intelligence Platform
APP_VERSION=1.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Provider selection: 'openai' or 'gemini'
LLM_PROVIDER=openai

# Model selection.
# For OpenAI: 'gpt-4o-mini', 'gpt-4o', etc.
# For Gemini: 'gemini-2.5-flash', etc.
LLM_MODEL=gpt-4o-mini

# API key for LLM calls (OpenAI or Gemini API key). Leave blank for offline testing.
LLM_API_KEY=

# ── Embedding Provider ───────────────────────────────────────────────────────
# Provider selection: 'openai' or 'gemini'
EMBEDDING_PROVIDER=openai

# Model selection.
# For OpenAI: 'text-embedding-3-small', 'text-embedding-3-large'
# For Gemini: 'gemini-embedding-2'
EMBEDDING_MODEL=text-embedding-3-small

# Configured embedding vector dimensionality (Gemini 2 uses 768)
EMBEDDING_DIMENSIONS=768

# ── Vector Store ─────────────────────────────────────────────────────────────
# Provider selection: 'chroma' (local/testing) or 'qdrant' (cloud/production)
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_COLLECTION=knowledge_base
# Directory for persistent ChromaDB storage. Leave blank for ephemeral in-memory.
VECTOR_STORE_PERSIST_DIRECTORY=./.chroma_data

# ── Qdrant Cloud Configuration ───────────────────────────────────────────────
# Required only when VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base
QDRANT_TIMEOUT_SECONDS=10.0

# ── Workspace Limits (Free Tier Protection) ──────────────────────────────────
MAX_DOCUMENTS_PER_WORKSPACE=50
MAX_CHUNKS_PER_WORKSPACE=1000

# ── Document Ingestion ───────────────────────────────────────────────────────
# Max upload size in bytes (default: 2 MB)
MAX_UPLOAD_BYTES=2097152

# ── Chunking ─────────────────────────────────────────────────────────────────
# chunk_overlap must be strictly less than chunk_size
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_DEFAULT_TOP_K=5
# Optional float threshold for distance filtering (leave blank = no threshold)
RETRIEVAL_DEFAULT_THRESHOLD=

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_PROMPT_VERSION=v1
RAG_EMPTY_CONTEXT_MESSAGE="I could not find relevant information in the knowledge base to answer your question."

# ── Frontend Configuration ───────────────────────────────────────────────────
# Base URL of the FastAPI backend that the Streamlit frontend calls.
# Local development default: http://127.0.0.1:8000
# Deployed Streamlit Community Cloud: set to your deployed Render URL:
#   KIP_API_BASE_URL=https://kip-api.onrender.com
KIP_API_BASE_URL=http://127.0.0.1:8000

# ── Public Feedback (v1.1) ───────────────────────────────────────────────────
# Webhook URL for persisting user feedback submitted via the "Help Improve KIP"
# feedback box. The backend POSTs a JSON payload { category, message, timestamp }
# to this URL (e.g., a Make/Zapier webhook, a Slack incoming webhook, or any
# HTTPS endpoint that accepts JSON). Feedback is rejected at the API layer if
# this variable is not set, so the app will not silently discard submissions.
# Required for deployed (Render) environments; optional for local testing.
FEEDBACK_WEBHOOK_URL=
