# Knowledge Intelligence Platform v1.0 — Local Environment Variables
# Copy this file to `.env` for local development. Never commit `.env`.
# All settings have defaults; only LLM_API_KEY is required for live LLM use.

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=Knowledge Intelligence Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Provider selection: 'openai' or 'gemini'
LLM_PROVIDER=openai

# Model selection.
# For OpenAI: 'gpt-4o-mini', 'gpt-4o', etc.
# For Gemini: 'gemini-2.5-flash', etc.
LLM_MODEL=gpt-4o-mini

# REQUIRED for live LLM calls. Leave blank to use deterministic fakes in tests.
# If using Gemini, set this to your Gemini API Key.
LLM_API_KEY=

# ── Document Ingestion ───────────────────────────────────────────────────────
# Max upload size in bytes (default: 2 MB)
MAX_UPLOAD_BYTES=2097152

# ── Chunking ─────────────────────────────────────────────────────────────────
# chunk_overlap must be < chunk_size
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Embedding Provider ───────────────────────────────────────────────────────
# Provider selection: 'openai' or 'gemini'
EMBEDDING_PROVIDER=openai

# Model selection.
# For OpenAI: 'text-embedding-3-small', 'text-embedding-3-large', etc.
# For Gemini: 'text-embedding-004', etc.
EMBEDDING_MODEL=text-embedding-3-small

# ── Vector Store ─────────────────────────────────────────────────────────────
VECTOR_STORE_PROVIDER=chroma
VECTOR_STORE_COLLECTION=knowledge_base
# Directory for persistent ChromaDB storage. Leave blank for ephemeral (tests only).
VECTOR_STORE_PERSIST_DIRECTORY=./.chroma_data

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_DEFAULT_TOP_K=5
# Optional float threshold for similarity filtering (leave blank = no threshold)
RETRIEVAL_DEFAULT_THRESHOLD=

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_PROMPT_VERSION=v1
RAG_EMPTY_CONTEXT_MESSAGE="I could not find relevant information in the knowledge base to answer your question."
